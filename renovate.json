{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":timezone(America/Vancouver)"],
  "dependencyDashboardTitle": "Renovate Dashboard",
  "packageRules": [
    {
      "description": "Merge non-major updates once the required checks on main pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
