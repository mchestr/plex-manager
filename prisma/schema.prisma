// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User model
model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  plexUserId            String?                @unique
  plexAuthToken         String? // Plex auth token (stored during login for watchlist API access)
  jellyfinUserId        String?                @unique // Jellyfin user ID (if user was created via Jellyfin invite)
  primaryAuthService    AuthService? // The service the member joined with; written at invite, sign-in and import (P11.10)
  isAdmin               Boolean                @default(false)
  role                  String? // A built-in non-admin role key (lib/permissions); null = none. An unknown value grants nothing
  onboardingStatus      Json?                  @default("{\"plex\": false, \"jellyfin\": false}") // Track onboarding completion per service
  plexWrapped           PlexWrapped[]
  llmUsage              LLMUsage[]
  chatConversations     ChatConversation[]
  inviteUsages          InviteUsage[]
  discordConnection     DiscordConnection?
  discordOAuthStates    DiscordOAuthState[]
  userMediaMarks        UserMediaMark[]
  watchlistSyncSettings WatchlistSyncSettings?
  watchlistSyncHistory  WatchlistSyncHistory[]
  subscription          Subscription?
  isExempt              Boolean                @default(false) // Exempt from the subscription requirement; the only flag that grants access without a subscription
  exemptNote            String? // Optional admin note about the exemption (e.g. "IT support"); no behavior
  timezone              String? // IANA zone the member chose for Rewind; null = the server zone
  sessionVersion        Int                    @default(0) // Bumped by endUserSessions(); a JWT carrying another version ends
  disabledAt            DateTime? // Set by an admin; a disabled user cannot sign in and their sessions end
  requestTiersExcluded  Boolean                @default(false) // The request-tier sync leaves this member's Overseerr quota alone
  announcementsSeenAt   DateTime? // The newest announcement the member has seen; later ones carry the "New" pip
  rewindGenerations     RewindGeneration[]
  rewindPrefs           RewindPrefs[]
  rewindExclusions      RewindExclusion[]
  discordCommandLogs    DiscordCommandLog[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([isAdmin])
  @@index([primaryAuthService])
  @@index([isExempt])
}

/// A member's media server (P11.10). `lib/member/service.ts` reads it with the linked identifiers.
enum AuthService {
  plex
  jellyfin
}

// Setup and Configuration models
model Setup {
  id          String    @id @default(cuid())
  isComplete  Boolean   @default(false)
  // The wizard's position: a SetupStepId (types/setup.ts) or "summary" (P10.24)
  currentStepId String  @default("plex")
  completedAt DateTime?
  // The first-run claim (P11.32, lib/setup/claim.ts): the SHA-256 of the newest
  // setup code (cleared once used), and the claim the `pm-setup` cookie names.
  // Both are cleared when setup completes.
  claimCodeHash     String?
  claimCodeIssuedAt DateTime?
  claimId           String?
  claimedAt         DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PlexServer {
  id                String   @id @default(cuid())
  name              String
  url               String // Full URL including protocol, hostname, and port (e.g. https://plex.example.com:32400)
  publicUrl         String? // Public facing URL (e.g. https://plex.example.com)
  token             String
  adminPlexUserId   String? // Plex user ID of the admin (user who configured this server)
  machineIdentifier String? // PMS /identity machineIdentifier: written on save, filled lazily on the first identity call (P11.8)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
  @@index([adminPlexUserId])
}

model JellyfinServer {
  id              String   @id @default(cuid())
  name            String
  url             String // Full URL including protocol, hostname, and port (e.g. http://jellyfin.example.com:8096)
  publicUrl       String? // Public facing URL (e.g. https://jellyfin.example.com)
  apiKey          String // Jellyfin API key for admin operations
  adminUserId     String? // Jellyfin user ID of the admin who configured this server
  isActive        Boolean  @default(true)
  enabledForLogin Boolean  @default(true) // "Allow Jellyfin sign-in": when false, Jellyfin sign-in is refused and hidden from the login page
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([adminUserId])
}

model Tautulli {
  id        String   @id @default(cuid())
  name      String
  url       String // Full URL including protocol, hostname, and port (e.g. http://tautulli.example.com:8181)
  publicUrl String? // Public facing URL (e.g. https://tautulli.example.com)
  apiKey    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Overseerr {
  id        String   @id @default(cuid())
  name      String
  url       String // Full URL including protocol, hostname, and port (e.g. http://overseerr.example.com:5055)
  publicUrl String? // Public facing URL (e.g. https://requests.example.com)
  apiKey    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Sonarr {
  id        String   @id @default(cuid())
  name      String
  url       String // Full URL including protocol, hostname, and port (e.g. http://sonarr.example.com:8989)
  publicUrl String? // Public facing URL (e.g. https://sonarr.example.com)
  apiKey    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Radarr {
  id        String   @id @default(cuid())
  name      String
  url       String // Full URL including protocol, hostname, and port (e.g. http://radarr.example.com:7878)
  publicUrl String? // Public facing URL (e.g. https://radarr.example.com)
  apiKey    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model LLMProvider {
  id          String   @id @default(cuid())
  provider    String // Currently "openai", but extensible for other providers
  purpose     String // "chat" or "wrapped" - distinguishes between chat assistant and wrapped generation configs
  apiKey      String
  model       String // Required - no default model allowed
  temperature Float? // Temperature setting (0.0-2.0), null uses model default
  maxTokens   Int? // Max tokens for completion, null uses default (6000)
  baseUrl     String? // openai-compatible endpoint (admin-only)
  effort      String? // reasoning effort, mapped per provider
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([provider])
  @@index([purpose])
}

// Plex Wrapped models
model PlexWrapped {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        String // JSON string containing wrapped data
  year        Int // Year this wrapped is for
  status      String              @default("pending") // "pending", "generating", "completed", "failed"
  error       String? // Error message if status is "failed"
  shareToken  String?             @unique // Random token for sharing (URL-safe, unguessable)
  summary     String? // Shareable summary text for social sharing
  archetype   String? // v2: archetype display name for share cards/OG images without parsing data JSON
  generatedAt DateTime?
  // Set only by v3 writes; v1 and v2 rows keep the default and the parser reads `version` from the JSON
  dataVersion Int                 @default(2)
  edition     String? // v3: "full", "pocket" or "postcard"
  factsHash   String? // v3: sha256 of the canonical facts JSON
  dataThrough DateTime? // v3: end of the data window this issue covers
  finalCutAt  DateTime? // v3: when the full-year final cut replaced the season issue
  notifiedAt  DateTime? // v3: when the member was told the issue is ready
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  llmUsage    LLMUsage[] // Multiple LLM usage records can be associated with a wrapped (for regenerations)
  shareVisits WrappedShareVisit[] // Track visits to shared wraps
  generations RewindGeneration[]
  shares      RewindShare[]
  views       RewindView[]

  @@unique([userId, year])
  @@index([year])
  @@index([status])
}

// One generation attempt of a Rewind (v3). The job writes PlexWrapped.data
// only in its final transaction and keeps the data it replaced for one rollback.
model RewindGeneration {
  id           String      @id @default(cuid())
  wrappedId    String
  wrapped      PlexWrapped @relation(fields: [wrappedId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  year         Int
  kind         String // "season", "final-cut", "admin", "member"
  status       String      @default("queued") // "queued", "running", "completed", "failed", "skipped"
  jobId        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  error        Json? // typed error code, never a roster
  factsHash    String?
  copySource   String? // "llm", "repair", "template", "mixed"
  copyPolicy   String      @default("default") // "default", "no-llm", "changed-slots"
  llmCalls     Int         @default(0)
  costUsd      Decimal?    @db.Decimal(10, 4)
  previousData String? // the PlexWrapped.data this generation replaced, kept until 2027-06-30
  createdAt    DateTime    @default(now())
  llmUsage     LLMUsage[]

  @@index([userId, year, status])
  @@index([status, startedAt])
  @@index([wrappedId])
}

// A v3 share link. Only the SHA-256 of the token is stored; card and poster
// URLs use the separate asset key.
model RewindShare {
  id            String                @id @default(cuid())
  wrappedId     String
  wrapped       PlexWrapped           @relation(fields: [wrappedId], references: [id], onDelete: Cascade)
  tokenHash     String                @unique
  assetKey      String                @unique // 16 random bytes, base64url
  pages         Json // shared page types, registry order
  signed        Boolean               @default(false)
  includeArt    Boolean               @default(false)
  dailyDetail   Boolean               @default(false)
  cardFacts     Json
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime              @default(now())
  rotatedFromId String?
  visitDays     RewindShareVisitDay[]

  @@index([wrappedId])
}

// Daily visit counts per share link, kept 90 days (replaces WrappedShareVisit)
model RewindShareVisitDay {
  shareId String
  share   RewindShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  day     DateTime    @db.Date
  count   Int         @default(0)

  @@id([shareId, day])
  @@index([day])
}

// A member's sharing and notification choices for one Rewind year
model RewindPrefs {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year              Int
  signed            Boolean  @default(false)
  includeArt        Boolean  @default(false)
  dailyDetail       Boolean  @default(false)
  cardFacts         Json?
  notify            Boolean  @default(true)
  exclusionsVersion Int      @default(0) // bumped by hide and unhide; part of the card cache key
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, year])
}

// A title the member hid from their Rewind
model RewindExclusion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratingKey String
  kind      String // "film", "series"
  title     String?  @db.VarChar(200) // copied from the member's own page data at hide time, for the unhide list; never projected
  createdAt DateTime @default(now())

  @@unique([userId, ratingKey])
}

// The server-wide yearly aggregate a season fan-out reads
model RewindServerAggregate {
  id          String   @id @default(cuid())
  year        Int
  dataThrough DateTime
  computedAt  DateTime @default(now())
  data        Json

  @@unique([year, dataThrough])
}

// Plex metadata for a rating key, cached for the stats engine
model MediaMetadataCache {
  ratingKey             String    @id
  kind                  String
  librarySectionId      String
  addedAt               DateTime?
  genres                Json
  directors             Json
  actors                Json
  studio                String?
  contentRating         String?
  year                  Int?
  originallyAvailableAt DateTime?
  runtimeSec            Int?
  seasonEpisodeCounts   Json?
  guids                 Json
  videoResolution       String?
  hdr                   Boolean?
  fetchedAt             DateTime  @default(now())
}

// One open of a Rewind by its owner, kept 120 days (success measures). No IP.
model RewindView {
  id           String      @id @default(cuid())
  wrappedId    String
  wrapped      PlexWrapped @relation(fields: [wrappedId], references: [id], onDelete: Cascade)
  sessionKey   String // random per open
  edition      String
  furthestPage Int         @default(0)
  shareActions Json        @default("{}") // counts by kind: image, save, link
  createdAt    DateTime    @default(now())

  @@unique([wrappedId, sessionKey])
  @@index([createdAt])
}

// One run of the Rewind copy eval harness
model RewindEvalRun {
  id            String   @id @default(cuid())
  model         String
  promptVersion String
  fixtures      Json
  results       Json
  costUsd       Decimal  @db.Decimal(10, 4)
  createdBy     String?
  createdAt     DateTime @default(now())
}

// One provider Batch API submission (final cut)
model RewindBatch {
  id          String    @id @default(cuid())
  provider    String
  batchRef    String
  status      String
  itemCount   Int
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// Track visits to shared wraps
model WrappedShareVisit {
  id        String      @id @default(cuid())
  wrappedId String
  wrapped   PlexWrapped @relation(fields: [wrappedId], references: [id], onDelete: Cascade)
  ipAddress String? // IP address of the visitor (for analytics)
  userAgent String? // User agent string (for analytics)
  referer   String? // Referer URL if available
  createdAt DateTime    @default(now())

  @@index([wrappedId])
  @@index([createdAt])
}

model ChatConversation {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  endedAt         DateTime?
  usage           LLMUsage[]
  discordSessions DiscordChatSession[]

  @@index([userId])
  @@index([createdAt])
}

// LLM Usage tracking for cost analysis
// This model stores ALL LLM usage, including regenerations of wrapped content
// wrappedId is optional to allow tracking LLM usage even without a wrapped
model LLMUsage {
  id                 String            @id @default(cuid())
  wrappedId          String? // Optional - allows tracking usage without a wrapped
  wrapped            PlexWrapped?      @relation(fields: [wrappedId], references: [id], onDelete: SetNull)
  chatConversationId String?
  chatConversation   ChatConversation? @relation(fields: [chatConversationId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String // Currently "openai", but extensible for other providers
  model              String? // Model used (e.g., "gpt-4", "openai/gpt-4")
  prompt             String? // The prompt sent to the LLM; null once removed by the October 2026 privacy clean-up (P0.20)
  response           String? // The full response from the LLM; null once removed by the October 2026 privacy clean-up (P0.20)
  promptTokens       Int // Number of tokens in the prompt
  completionTokens   Int // Number of tokens in the completion
  totalTokens        Int // Total tokens used
  cost               Float // Estimated cost in USD
  cachedInputTokens  Int               @default(0)
  reasoningTokens    Int               @default(0)
  serviceTier        String?
  batchId            String?
  promptVersion      String?
  factsHash          String?
  generationId       String?
  generation         RewindGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  outcome            String            @default("ok") // "ok", or why a billed call failed
  // The LLM usage list's row: the conversation id for assistant calls, else unique to the call (P10.2)
  groupKey           String            @default(uuid())
  createdAt          DateTime          @default(now())

  @@index([userId])
  @@index([wrappedId])
  @@index([generationId])
  @@index([chatConversationId])
  @@index([groupKey, createdAt])
  @@index([provider])
  @@index([createdAt])
}

// Application Configuration (singleton pattern)
model Config {
  id                           String    @id @default("config")
  llmDisabled                  Boolean   @default(false) // When true, LLM calls are disabled and mock data is returned
  wrappedEnabled               Boolean   @default(true) // When false, wrapped generation is disabled
  wrappedGenerationStartDate   DateTime? // Legacy: migrated to rewindSeasonOpens (P2.2), no longer written; P11.18 drops it
  wrappedGenerationEndDate     DateTime? // Legacy: migrated to rewindSeasonCloses (P2.2), no longer written; P11.18 drops it
  watchlistSyncEnabled         Boolean   @default(false) // Global toggle for watchlist sync feature
  watchlistSyncIntervalMinutes Int       @default(60) // Default sync interval in minutes (minimum 15)
  stripeEnabled                Boolean   @default(false) // Global toggle for the Stripe subscription requirement
  stripeSecretKey              String? // Stripe secret API key (encrypted at rest)
  stripeWebhookSecret          String? // Stripe webhook signing secret (encrypted at rest)
  stripePriceIds               Json? // JSON array of allowed Stripe price-id strings
  stripeLibrarySectionIds      Json? // JSON array of Plex library section keys granted to subscribers (null = all libraries)
  timezone                     String? // IANA zone of the server; null resolves to TZ, then UTC
  locale                       String    @default("en-US") // BCP 47 locale for dates and numbers
  serverName                   String? // Brand name; null falls back to the Plex server's name
  rewindSeasonOpens            String    @default("12-01") // month-day, in the server zone
  rewindSeasonCloses           String    @default("01-31") // month-day, in the server zone
  rewindEnabled                Boolean   @default(false)
  rewindAudience               String    @default("admins") // "admins", "all"
  rewindLlmMode                String    @default("standard") // "standard", "economy", "off"
  rewindLlmBudgetUsd           Decimal   @default(10) @db.Decimal(10, 2)
  rewindNotifyChannels         Json      @default("[\"discord\", \"banner\"]")
  rewindPublicLinks            Boolean   @default(true)
  rewindPublicCounts           Boolean   @default(false)
  rewindShowServerNameOnCards  Boolean   @default(true)
  rewindAllowArtOnCards        Boolean   @default(true)
  rewindExcludedSectionIds     Json?
  rewindExcludedContentRatings Json?
  rewindIncludeManagedUsers    Boolean   @default(false)
  rewindAudio                  Boolean   @default(false)
  rewindDisabledPages          Json?
  rewindSerialKey              String? // HMAC key for member serials (encrypted at rest)
  llmDailyCapPerUserUsd        Float     @default(0.5) // Daily assistant spend per member, server-zone day (P4.20)
  llmDailyCapAdminUsd          Float     @default(5) // Daily assistant spend per admin
  llmDailyCapServerUsd         Float     @default(5) // Daily assistant spend for the whole server
  lightThemeEnabled            Boolean   @default(false) // Members may pick the light theme (P10.10, ui-design-system 3.3)
  lastRetentionRunAt           DateTime? // When the retention sweep last finished (P11.14)
  lastRetentionSummary         Json? // That run's per-rule counts (P11.14)
  discordStatsEnabled          Boolean   @default(false) // Rename Discord channels with live server stats
  discordStatsIntervalMinutes  Int       @default(10) // Minutes between renames (minimum 10: Discord allows 2 renames per channel in 10 minutes)
  discordStatsChannels         Json? // { [stat]: { channelId, format } }, validated by lib/discord/channel-stats/config.ts
  discordStatsLastNames        Json? // { [stat]: name } the channels were last renamed to, so an unchanged name is not sent again
  requestTiersEnabled          Boolean   @default(false) // Daily Overseerr request limits from Tautulli watch time
  requestTiersRunHour          Int       @default(0) // Hour of the day (server zone) the tier sync runs
  requestTiers                 Json? // The tier table; null uses DEFAULT_TIERS (lib/request-tiers/tiers.ts)
  encryptionCanary             String? // A known value under the primary key; boot checks it decrypts (P11.1)
  encryptionFieldsHash         String? // "<kid>:<ENCRYPTED_FIELDS hash>" the last full re-encryption finished under (P11.1)
  updatedAt                    DateTime  @updatedAt
  updatedBy                    String? // User ID who last updated this config
}

model DiscordIntegration {
  id               String   @id @default("discord")
  isEnabled        Boolean  @default(false)
  botEnabled       Boolean  @default(false)
  clientId         String?
  clientSecret     String?
  botToken         String? // Discord bot token (encrypted at rest, like clientSecret)
  supportChannelId String? // Channel the bot monitors for support (plaintext)
  supportThreadIds Json? // JSON array of support thread ID strings (plaintext)
  configVersion    Int      @default(0) // Bumped on every config change; drives Step 18's rotation-bounce
  guildId          String?
  serverInviteCode String?
  platformName     String   @default("Plex Wrapped")
  instructions     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}

// One lease per background role ("discord-bot", "watchlist-sync"): only one
// process holds a name at a time (lib/locks/lease-lock.ts).
model LeaseLock {
  name          String   @id
  instanceId    String // Unique identifier for the holding process
  acquiredAt    DateTime
  expiresAt     DateTime // The lease lapses if not renewed (handles crashed pods)
  lastRenewedAt DateTime

  @@index([expiresAt])
}

model DiscordConnection {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordUserId    String    @unique
  username         String
  discriminator    String?
  globalName       String?
  avatar           String?
  accessToken      String
  refreshToken     String?
  scope            String?
  expiresAt        DateTime?
  metadataSyncedAt DateTime?
  /// Watched hours from the last daily role reconcile; event-driven role syncs push it unchanged (P4.18)
  lastWatchedHours Int?
  linkedAt         DateTime  @default(now())
  revokedAt        DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([linkedAt])
}

model DiscordChatSession {
  id                 String           @id @default(cuid())
  discordUserId      String
  discordChannelId   String
  chatConversationId String
  chatConversation   ChatConversation @relation(fields: [chatConversationId], references: [id], onDelete: Cascade)
  messages           Json
  lastMessageAt      DateTime         @default(now())
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([discordUserId, discordChannelId])
  @@index([chatConversationId])
}

model DiscordOAuthState {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state        String    @unique
  codeVerifier String
  redirectTo   String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Short-lived parked media-mark selections for the Discord mark flow.
// Replaces the previous in-memory Map + setInterval sweeper: rows are cleaned
// up opportunistically on read (see lib/discord/commands/mark/pending-store.ts).
model DiscordPendingSelection {
  id            String   @id @default(cuid())
  discordUserId String
  channelId     String
  customId      String   @unique
  markType      MarkType
  results       Json
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([discordUserId, channelId])
  @@index([expiresAt])
}

// Prompt Template for LLM generation
model PromptTemplate {
  id          String   @id @default(cuid())
  name        String // Human-readable name for the template
  description String? // Optional description
  template    String // The prompt template with placeholders like {{userName}}, {{year}}, etc.
  kind        String   @default("v2-full") // "v2-full" (the v2 prompt) or "rewind-style-guide" (appended to the v3 prompt)
  isActive    Boolean  @default(false) // Only one active template of each kind at a time
  version     Int      @default(1) // Version number for tracking changes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String? // User ID who last updated this template

  @@index([isActive])
  @@index([name])
}

// Server Statistics are now calculated on the fly - no database caching needed

model Invite {
  id         String     @id @default(cuid())
  code       String     @unique
  serverType ServerType @default(PLEX) // Which media server this invite is for
  maxUses    Int        @default(1)
  useCount   Int        @default(0)
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  createdBy  String? // Admin User ID who created the invite

  // Plex-specific library access settings
  librarySectionIds String? // JSON array of Plex library section IDs to share (null = all libraries)
  allowDownloads    Boolean @default(false) // Allow downloads (Plex allowSync)

  // Jellyfin-specific library access settings
  jellyfinLibraryIds String? // JSON array of Jellyfin library IDs to grant access (null = all libraries)

  usages InviteUsage[]

  @@index([serverType])
}

model InviteUsage {
  id       String   @id @default(cuid())
  inviteId String
  invite   Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt   DateTime @default(now())

  @@index([inviteId])
  @@index([userId])
}

model UserMediaMark {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Media identification
  mediaType     MediaType
  plexRatingKey String

  // Radarr/Sonarr IDs (if available)
  radarrId        Int?
  radarrTitleSlug String?
  sonarrId        Int?
  sonarrTitleSlug String?

  // Media metadata (cached for display)
  title         String
  year          Int?
  seasonNumber  Int?
  episodeNumber Int?
  parentTitle   String?

  // Mark details
  markType MarkType
  note     String?

  // Tracking
  markedAt         DateTime @default(now())
  markedVia        String
  discordChannelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, plexRatingKey, markType])
  @@index([userId, mediaType])
  @@index([userId, markedAt])
  @@index([plexRatingKey])
  @@index([markType])
  @@index([markedAt])
}

enum MediaType {
  MOVIE
  TV_SERIES
  EPISODE
}

enum ServerType {
  PLEX
  JELLYFIN
}

enum MarkType {
  FINISHED_WATCHING
  NOT_INTERESTED
  KEEP_FOREVER
  REWATCH_CANDIDATE
  POOR_QUALITY
  WRONG_VERSION
}

// Discord Command Audit Log - tracks all Discord bot interactions
model DiscordCommandLog {
  id String @id @default(cuid())

  // Discord user info
  discordUserId   String
  discordUsername String?

  // Linked app user (if available); removing the member deletes their rows first, and SetNull covers the rest
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Command details
  commandType DiscordCommandType
  commandName String // e.g., "!finished", "!assistant", "!clear"
  commandArgs String? // Arguments passed to the command; always null for CHAT rows (GAP-32)
  argsLength  Int? // Characters a member typed to the assistant (CHAT rows), never the text

  // Context
  channelId   String
  channelType String // "dm", "support-channel", "thread"
  guildId     String?

  // Execution details
  status         DiscordCommandStatus @default(PENDING)
  error          String?
  responseTimeMs Int? // Time to process the command

  // Timestamps
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([discordUserId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([commandType])
  @@index([commandName])
  @@index([status])
  @@index([createdAt])
  @@index([channelId])
}

enum DiscordCommandType {
  CHAT // Chatbot interactions (!assistant, !bot, !support, DMs, mentions)
  MEDIA_MARK // Media marking commands (!finished, !not-interested, etc.)
  CLEAR_CONTEXT // Context clear commands (!clear, !reset)
  SELECTION // Numeric selection responses (1-5)
  LINK_REQUEST // User not linked, requested to link account
  HELP // Help/command discovery (!help, !commands)
}

enum DiscordCommandStatus {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT
}

// Admin Announcements for home page
model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String // Markdown content
  priority  Int       @default(0) // Higher = more important, shown first
  isActive  Boolean   @default(true)
  expiresAt DateTime? // Auto-hide after this date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String? // Admin user ID

  @@index([isActive, expiresAt])
  @@index([priority])
}

// Watchlist Sync - Per-user sync settings
model WatchlistSyncSettings {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncEnabled         Boolean   @default(false)
  lastSyncAt          DateTime?
  lastSyncStatus      String? // "success", "partial", "failed"
  lastSyncError       String?
  itemsSynced         Int       @default(0) // Items processed in last sync
  itemsRequested      Int       @default(0) // Items requested in last sync
  totalItemsSynced    Int       @default(0) // Cumulative total items synced
  totalItemsRequested Int       @default(0) // Cumulative total requests created
  itemsSkipped        Int       @default(0) // Items with no TMDB match in last sync
  watchlistEtag       String? // ETag of the last complete watchlist read; a 304 skips the run
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([syncEnabled])
}

// Watchlist Sync - Track synced items to avoid duplicates
model WatchlistSyncHistory {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plexRatingKey      String // Plex discover rating key
  guid               String // GUID string (e.g., "tmdb://12345")
  mediaType          MediaType
  title              String
  year               Int?
  tmdbId             Int?
  tvdbId             Int?
  imdbId             String?
  syncedAt           DateTime            @default(now())
  requestedAt        DateTime? // When submitted to Overseerr
  overseerrRequestId Int? // Overseerr request ID if submitted
  status             WatchlistSyncStatus @default(SYNCED)

  @@unique([userId, plexRatingKey])
  @@index([userId, syncedAt])
  @@index([status])
}

enum WatchlistSyncStatus {
  SYNCED // Item tracked but not requested
  REQUESTED // Submitted to Overseerr
  ALREADY_AVAILABLE // Already in library
  ALREADY_REQUESTED // Already has pending request
  FAILED // Request submission failed; retried on the next sync
  REMOVED_FROM_WATCHLIST // Removed from Plex watchlist
  SKIPPED_NO_EXTERNAL_ID // Plex metadata has no TMDB id, so nothing can be requested
  NOT_PERMITTED // Overseerr refused the request (403: quota or permission); terminal
}

// Stripe Subscriptions - one-to-one with User
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique // Stripe customer id
  stripeSubscriptionId String?            @unique // Stripe subscription id
  status               SubscriptionStatus @default(INCOMPLETE)
  priceId              String? // Stripe price id the user is subscribed to
  currentPeriodEnd     DateTime? // End of the current paid period
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime? // When the subscription was canceled
  plexInviteStatus     String? // Tracks Plex invite lifecycle (e.g. "invited", "accepted")
  jellyfinAccessStatus String? // The Jellyfin account the grant or revoke left: "enabled", "disabled" or "skipped" (P11.11)
  accessSkipCode       String? // Why the last grant or revoke changed nothing, e.g. "NO_MEMBER_SERVICE"; null after one that acted
  stripeEventAt        DateTime? // `created` of the newest Stripe event applied; older events are skipped (SEC-37)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // stripeCustomerId/stripeSubscriptionId are @unique (already indexed).
  @@index([status])
}

// Stripe webhook idempotency - keyed by the Stripe event id. An event counts as
// handled only once `processedAt` is set, after its handler succeeded (SEC-40).
model StripeEvent {
  id          String    @id // Stripe event id (evt_...)
  type        String // Stripe event type (e.g. customer.subscription.updated)
  receivedAt  DateTime  @default(now())
  attempts    Int       @default(0)
  lastError   String? // An error code from the last failed attempt, never a message
  processedAt DateTime?

  @@index([type])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

// Append-only audit trail (SEC-55). Every logAuditEvent call writes one row;
// no code path updates or deletes rows. `actorUserId` is a user id, or "setup"
// for the first-run wizard, and is not a foreign key, so a row outlives its user.
// `details` hold the sanitised event details (for CONFIG_CHANGED, a redacted diff).
model AuditLog {
  id           String   @id @default(cuid())
  type         String
  actorUserId  String
  targetUserId String?
  details      Json?
  requestId    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([targetUserId])
}

/// One run of the request-tier sync (lib/request-tiers/run.ts): who got which tier and the quota before and after.
model RequestTierRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  trigger    String // "scheduled" or "admin"
  updated    Int       @default(0) // Quotas written to Overseerr
  unchanged  Int       @default(0) // Quotas already right, so Overseerr was not called
  failed     Int       @default(0)
  skipped    Int       @default(0) // Excluded members
  entries    Json // RequestTierEntry[]
  error      String? // Set when the run could not start (no Tautulli or Overseerr, say)

  @@index([startedAt])
}

// An MCP server the admin assistant can call (Streamable HTTP). A tool is off
// until the admin turns it on: only names in `enabledTools` reach the model.
model McpServer {
  id              String   @id @default(cuid())
  name            String   @unique // Shown to the admin and used in the tool names (mcp_<slug>_<tool>)
  url             String // Full URL of the MCP endpoint
  authHeaderName  String? // e.g. "Authorization" or "X-Api-Key"
  authHeaderSecret String? // ENCRYPTED: the header's value, e.g. "Bearer ..."
  isActive        Boolean  @default(true)
  enabledTools    String[] // MCP tool names the admin turned on
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

// A Markdown knowledge base in a GitHub repository the admin assistant searches
// and cites (for example mchestr/knowledgebase).
model KnowledgeSource {
  id        String   @id @default(cuid())
  name      String   @unique
  repo      String // owner/name
  ref       String   @default("main") // Branch, tag or commit
  path      String   @default("") // Only files under this folder; empty = the whole repo
  token     String? // ENCRYPTED: a GitHub token for a private repository
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}
