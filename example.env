# Docker Compose (development)
# docker-compose.yml refuses to start without these two. It binds Postgres and
# Redis to 127.0.0.1 only, and builds the app container's DATABASE_URL and
# REDIS_URL from them. Generate each with: openssl rand -hex 16
# A database volume created before this setting keeps the password it was
# created with ("postgres"): set POSTGRES_PASSWORD to that, or change it with
# ALTER USER postgres PASSWORD '...'.
POSTGRES_PASSWORD=""
REDIS_PASSWORD=""

# Database
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# With the compose database, use POSTGRES_PASSWORD from above as the password:
DATABASE_URL="postgresql://postgres:your-postgres-password@localhost:5432/plex_wrapped?schema=public"
#
# Database pool limits. The Prisma 7 pg adapter ignores ?connection_limit= and
# pool_timeout in DATABASE_URL; set these instead. Migrations use the Prisma
# CLI's own connection and are unaffected.
# PROCESS_ROLE="all"              # web, worker or all; picks the defaults below
# DB_POOL_MAX=12                  # default: 10 web, 5 worker, 12 all
# DB_CONNECTION_TIMEOUT_MS=10000  # how long a query waits for a free connection
# DB_STATEMENT_TIMEOUT_MS=60000   # default: 15000 web, 120000 worker, 60000 all

# Docker image only: set to "true" to start without applying migrations. The
# entrypoint still logs `prisma migrate status`. Use it when you apply
# migrations by hand after a backup, or on every replica but one; see
# docs/operations.md.
# SKIP_MIGRATIONS="false"

# Server time zone (an IANA name such as "America/Chicago"). Every date and
# time the app shows, season dates, announcement expiry and Rewind's clock
# times use the zone set in Admin > Settings (Config.timezone); until one is
# saved there, this TZ is used when it is a valid IANA name, else UTC. The
# admin setting overrides it.
# TZ="America/Chicago"

# Application URL Configuration
# NEXT_PUBLIC_APP_URL is used for public-facing URLs (sharing links, OG images, etc.)
# NEXTAUTH_URL is required by NextAuth.js for OAuth callbacks and session management
# In production, set both to your domain (e.g., https://yourdomain.com)
# For development, localhost is fine
# A production server refuses to start unless both are https (localhost,
# 127.0.0.1 and [::1] excepted), and warns when their origins differ.
# Session cookies are Secure (and named __Secure-...) exactly when
# NEXTAUTH_URL is https.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Signs session cookies. Required: a production server refuses to start when it
# is empty, shorter than 32 characters, has fewer than 10 distinct characters,
# or is a well-known placeholder. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# UNSAFE for any internet-facing install. "true" lets a production server run
# on plain http, for a LAN-only install without TLS. Every boot then logs a
# warning, and session cookies are not Secure, so anyone on the network path
# can read and replay them.
# ALLOW_INSECURE_HTTP="false"

# Encryption key for secrets stored at rest (external-service API keys/tokens).
# Optional but strongly recommended in production. Generate with: openssl rand -hex 32
# Use a DEDICATED value (do NOT reuse NEXTAUTH_SECRET).
# Rollout is non-destructive: existing plaintext rows keep working and are
# encrypted on their next write. Once set, keep this value stable — rotating it
# makes previously-encrypted secrets undecryptable until they are re-saved.
# ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# Plex Authentication
# No OAuth credentials needed - Plex uses PIN-based authentication
# PLEX_CLIENT_IDENTIFIER should be a unique identifier for your application instance
# It can be any string (doesn't need to be a UUID). Required: a production
# server refuses to start without it. Generate with: openssl rand -hex 16
# Keep it stable; Jellyfin's default device id is derived from it.
PLEX_CLIENT_IDENTIFIER=""

# Jellyfin sign-in (optional)
# JELLYFIN_DEVICE_ID is the DeviceId the app reports to Jellyfin when a member
# signs in with a Jellyfin password. Leave it unset: by default it is
# "plex-manager-" plus 16 hex characters derived from PLEX_CLIENT_IDENTIFIER,
# which stays the same across restarts. Set it only to choose your own value.
# With neither variable set, the app uses "plex-manager-server" and logs
# jellyfin.auth.device_id_fallback at warn.
# JELLYFIN_DEVICE_ID="plex-manager-home"

# Discord Bot / Linked Roles
# ENABLE_DISCORD_BOT="true"  # Set to "false" to disable bot attempts (default: enabled)
#                            # Uses distributed database lock - only one pod will run the bot automatically
# DISCORD_BOT_POLL_INTERVAL_MS=10000  # How often to try for the lock, re-check the bot switch and apply settings (default: 10000 = 10 seconds)
#                                     # The holder renews its 30 s lease every 10 s on its own timer, whatever this is set to
# The token, support channel and thread ids below are fallbacks, used only when
# Admin -> Settings -> Discord stores none.
# DISCORD_BOT_TOKEN="discord-bot-token"
# DISCORD_SUPPORT_CHANNEL_ID="123456789012345678"
# DISCORD_SUPPORT_THREAD_IDS="123456789012345678,234567890123456789"
# Account-linking URL in "link your account" nudges. Default: <base>/discord/link,
# where <base> is PLEX_WRAPPED_BASE_URL if set, else NEXT_PUBLIC_APP_URL.
# DISCORD_PORTAL_URL="https://yourdomain.com/discord/link"
# PLEX_WRAPPED_BASE_URL="https://yourdomain.com"  # First choice for the portal base above
#
# Slash-command and metadata registration scripts (npm run register-discord-*)
# DISCORD_CLIENT_ID="123456789012345678"             # Discord application id
# NEXT_PUBLIC_DISCORD_CLIENT_ID="123456789012345678" # Used when DISCORD_CLIENT_ID is unset
# DISCORD_GUILD_ID="123456789012345678"              # Register commands in one server, instantly, instead of globally

# =============================================================================
# DEVELOPMENT DEFAULTS FOR SETUP WIZARD
# =============================================================================
#
# SECURITY WARNING: These DEV_* variables are ONLY read when NODE_ENV=development
# AND DEV_SETUP_PREFILL=true, and only until setup is complete. They are completely
# ignored in production. Until setup completes, anyone who can reach the dev
# server can read them, including tokens and API keys.
#
# IMPORTANT SECURITY NOTES:
# - Never commit real API keys or tokens to version control
# - These values are stored in plaintext and may appear in logs
# - For production, always use the setup wizard UI to configure services
# - If you use these for local development, ensure your .env is in .gitignore
#
# HOW IT WORKS:
# - DEV_* variables pre-populate the setup wizard forms
# - Set DEV_SETUP_AUTO_SUBMIT=true for zero-click setup (forms auto-submit)
# - A warning banner appears in the UI when dev defaults are active
# =============================================================================

# Prefill: required for any DEV_* value below to reach the setup wizard
# DEV_SETUP_PREFILL="true"

# Auto-submit: Enable zero-click setup wizard (requires all fields populated)
# DEV_SETUP_AUTO_SUBMIT="true"

# -----------------------------------------------------------------------------
# Service Configuration Defaults
# -----------------------------------------------------------------------------
# URL format: include protocol and port (e.g., https://localhost:32400)

# Plex Server
DEV_PLEX_NAME="My Plex Server"
DEV_PLEX_URL="https://localhost:32400"
DEV_PLEX_TOKEN=""
# DEV_PLEX_PUBLIC_URL=""                      # Optional: public-facing URL for links

# Tautulli
DEV_TAUTULLI_NAME="My Tautulli Server"
DEV_TAUTULLI_URL="http://localhost:8181"
DEV_TAUTULLI_API_KEY=""
# DEV_TAUTULLI_PUBLIC_URL=""                  # Optional: public-facing URL for links

# Overseerr
DEV_OVERSEERR_NAME="My Overseerr Server"
DEV_OVERSEERR_URL="http://localhost:5055"
DEV_OVERSEERR_API_KEY=""
# DEV_OVERSEERR_PUBLIC_URL=""                 # Optional: public-facing URL for links

# Sonarr
DEV_SONARR_NAME="My Sonarr Server"
DEV_SONARR_URL="http://localhost:8989"
DEV_SONARR_API_KEY=""
# DEV_SONARR_PUBLIC_URL=""                    # Optional: public-facing URL for links

# Radarr
DEV_RADARR_NAME="My Radarr Server"
DEV_RADARR_URL="http://localhost:7878"
DEV_RADARR_API_KEY=""
# DEV_RADARR_PUBLIC_URL=""                    # Optional: public-facing URL for links

# -----------------------------------------------------------------------------
# Discord Integration Defaults
# -----------------------------------------------------------------------------
# DEV_DISCORD_ENABLED="false"                 # Enable Discord linked roles
# DEV_DISCORD_BOT_ENABLED="false"             # Enable Discord bot functionality
# DEV_DISCORD_CLIENT_ID=""                    # Discord application client ID
# DEV_DISCORD_CLIENT_SECRET=""                # Discord application client secret
# DEV_DISCORD_GUILD_ID=""                     # Restrict to specific Discord server
# DEV_DISCORD_SERVER_INVITE_CODE=""           # Discord server invite code
# DEV_DISCORD_PLATFORM_NAME=""                # Display name (default: "Plex Wrapped")
# DEV_DISCORD_INSTRUCTIONS=""                 # Internal admin notes

# -----------------------------------------------------------------------------
# Prometheus Defaults
# -----------------------------------------------------------------------------
# DEV_PROMETHEUS_NAME="My Prometheus"
# DEV_PROMETHEUS_URL="http://localhost:9090"
# DEV_PROMETHEUS_QUERY=""

# -----------------------------------------------------------------------------
# LLM Provider Defaults
# -----------------------------------------------------------------------------
# Generic LLM settings (used as fallback for both Chat and Wrapped)
DEV_LLM_PROVIDER="openai"
DEV_LLM_API_KEY=""
DEV_LLM_MODEL=""

# Chat Assistant AI (admin troubleshooting chatbot)
# These override the generic DEV_LLM_* settings for the chat purpose
# DEV_CHAT_LLM_PROVIDER="openai"
# DEV_CHAT_LLM_API_KEY=""
# DEV_CHAT_LLM_MODEL="gpt-4o-mini"
# DEV_CHAT_LLM_TEMPERATURE="0.7"              # 0.0-2.0, controls randomness
# DEV_CHAT_LLM_MAX_TOKENS="1000"              # Max tokens in response

# Wrapped Generation AI (Plex Wrapped story generation)
# These override the generic DEV_LLM_* settings for the wrapped purpose
# DEV_WRAPPED_LLM_PROVIDER="openai"
# DEV_WRAPPED_LLM_API_KEY=""
# DEV_WRAPPED_LLM_MODEL="gpt-4o"
# DEV_WRAPPED_LLM_TEMPERATURE="0.8"           # 0.0-2.0, controls randomness
# DEV_WRAPPED_LLM_MAX_TOKENS="6000"           # Max tokens in response

# LLM Request Timeout (optional)
# Timeout in milliseconds for LLM API calls (default: 300000 = 5 minutes)
# Increase this if you're experiencing timeout errors with complex prompts
# LLM_REQUEST_TIMEOUT_MS=300000

# Staging only: "1" lets scripts/rewind-final-cut.ts --apply rehearse the final
# cut with an early --through (the full-year window on data that ends earlier).
# Never set it in production.
# REWIND_STAGING="1"

# Logging Level (optional)
# Controls the verbosity of logs: error, warn, info, verbose, debug, silly
# Defaults to "debug" in development, "info" in production
# Set to "info" to turn off debug logs
# LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Job Queue (BullMQ)
# -----------------------------------------------------------------------------
# Rewind and Stripe subscriptions need Redis: it backs the job queue that
# generates Rewinds and processes Stripe webhooks. Without it, only the
# watchlist sync keeps working, through legacy PostgreSQL-based polling.
#
# REDIS_URL: Connection string for Redis
# Format: redis://[username:password@]host:port[/database]
# With the compose Redis, use REDIS_PASSWORD from above:
# REDIS_URL="redis://:your-redis-password@localhost:6379"
#
# ENABLE_QUEUE_WORKER: Enable/disable the queue worker (default: true when Redis is configured)
# Set to "false" to disable the worker (e.g., for dedicated worker deployments)
# ENABLE_QUEUE_WORKER="true"
#
# QUEUE_WORKER_CONCURRENCY: Number of concurrent jobs the worker can process (default: 5)
# QUEUE_WORKER_CONCURRENCY="5"
#
# The site starts serving without waiting for Redis. The worker then retries
# Redis with backoff for about two minutes; if it never answers, the worker
# stays off until the next restart.
#
# SHUTDOWN_GRACE_MS: on SIGTERM, how long to wait for running jobs, the Discord
# bot and open connections before exiting (default: 8000, below Docker's 10 s
# stop timeout). `npm run start:prod` sets NEXT_MANUAL_SIG_HANDLE=true so the
# app, not Next, handles the signal.
# SHUTDOWN_GRACE_MS="8000"
#
# Without Redis, the legacy polling watchlist sync runs instead:
# ENABLE_WATCHLIST_SYNC="true"              # "false" turns it off (default: on)
# WATCHLIST_SYNC_POLL_INTERVAL_MS="60000"   # How often it tries for the sync lock (default: 60000)

# -----------------------------------------------------------------------------
# Rewind
# -----------------------------------------------------------------------------
# REWIND_CACHE_DIR: where Rewind posters, cards and fonts are cached, resolved
# against the working directory (default: .next/cache/rewind). The cache can be
# rebuilt, so it needs no backup.
# REWIND_CACHE_DIR=".next/cache/rewind"

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Sign-in, invite, PIN, share, poster and admin requests are rate-limited.
# With REDIS_URL set, the counts live in Redis and are shared by every app
# process; without it (or while Redis is down) each process keeps its own.
#
# TRUSTED_PROXY_HOPS: How many reverse proxies in front of the app append to
# X-Forwarded-For (default: 1). The client address is the entry the outermost
# of them wrote, counted from the right; entries further left are sent by the
# client and ignored. Getting this wrong lets clients pick their own address:
#   1 - one proxy (Traefik, Caddy, nginx) in front of the app: the default
#   2 - a CDN or tunnel (Cloudflare) in front of that proxy. The inner proxy
#       must trust the CDN's address ranges (Traefik forwardedHeaders.trustedIPs,
#       Caddy trusted_proxies) or it drops the CDN's header, and the origin
#       should accept traffic only from the CDN.
#   0 - no proxy at all; best-effort, since clients can then choose their key
# Upgrading: earlier releases used the leftmost entry. Check this value against
# your proxy chain when you upgrade; see the README's deployment notes.
# TRUSTED_PROXY_HOPS="1"

# -----------------------------------------------------------------------------
# Stripe Subscriptions (optional)
# -----------------------------------------------------------------------------
# Stripe is OFF by default and behaves exactly like today when disabled.
#
# There are intentionally NO STRIPE_* environment variables. The secret key,
# webhook signing secret, and price IDs are stored ENCRYPTED in the Config
# singleton and configured entirely from the admin UI:
#   Admin -> Settings -> Stripe Subscriptions
#
# Requirements to use the feature:
#   - A running Redis-backed queue (REDIS_URL above) so the webhook jobs that
#     provision/deprovision Plex access are processed.
#   - A publicly reachable webhook endpoint at:
#         https://yourdomain.com/api/stripe/webhook
#     For local development, forward events with the Stripe CLI:
#         stripe listen --forward-to localhost:3000/api/stripe/webhook
#
# See docs/stripe.md for full setup, the events to register, grandfathering, and
# the cancel/removal lifecycle.

# =============================================================================
# TEST ONLY - NEVER IN PRODUCTION
# =============================================================================
# E2E Tests (Playwright)
# The E2E suite wipes users, Rewinds and service configs. It refuses to run
# unless E2E_DATABASE_URL names a database ending in _test, and it never uses
# DATABASE_URL above. Start the dedicated database first:
#   docker compose up -d db-playwright
#   DATABASE_URL=$E2E_DATABASE_URL npx prisma migrate deploy
# db-playwright uses POSTGRES_PASSWORD from above too.
E2E_DATABASE_URL="postgresql://postgres:your-postgres-password@localhost:5433/plex_manager_test?schema=public"

# Test-only: never set E2E_TEST_MODE in this file. Outside production it arms
# `npm run db:seed`. Playwright sets it for its own web server; pass it inline
# for the seed instead, which deletes all users, Rewinds and service configs
# and then creates test users. The seed runs only on a local host or a
# database ending in _test; never run it on a host that serves production:
#   DATABASE_URL=$E2E_DATABASE_URL E2E_TEST_MODE=true npm run db:seed
# The setup-wizard prefill has its own flag, DEV_SETUP_PREFILL, above.

# E2E Test Server Port
# Port for the dev server when running Playwright E2E tests (default: 3100)
# E2E_PORT="3100"
# Set to 1 to reuse an already-running server. Make sure it uses E2E_DATABASE_URL.
# E2E_REUSE_SERVER="1"

# Skips the live Plex and Prometheus connection checks (Playwright sets it for
# its own web server).
# SKIP_CONNECTION_TESTS="true"

# Serves the /dev/ui sheet of every UI primitive, the visual-regression target
# for components/ui (Playwright sets it for its own web server). Leave unset in
# production, where the route answers 404.
# ENABLE_DEV_UI="1"
