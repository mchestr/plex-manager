{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "instrumentation.ts!",
    "proxy.ts!",
    "scripts/*.{ts,tsx}!",
    "scripts/*.mjs!",
    "scripts/release/*.mjs!",
    "scripts/codemods/tokens.ts!",
    "scripts/design-system/rewind-motion.mjs!",
    "lib/wrapped/facts/*.ts!",
    "lib/wrapped/archetypes/*.ts!",
    "lib/wrapped/copy/*.ts!",
    "lib/utils/format.ts!",
    "lib/rewind/format.ts!",
    "lib/rewind/registry.ts!",
    "lib/rewind/typeset/fit-lines.ts!",
    "lib/rewind/typeset/metrics.ts!",
    "lib/wrapped/sources/fixture-source.ts!",
    "evals/rewind/generate-fixtures.ts!",
    "evals/rewind/run.ts!",
    "evals/rewind/bake-off.ts!",
    // v2 mock data for the E2E seed and the v2 viewer tests, which knip --production never sees
    "lib/wrapped/mock-data.ts!",
    // a test helper for Rewind component tests (P5 onwards), which knip --production never sees
    "lib/design/testing.ts!",
    // the share visit counter (P5.11); P7.5's share page is its first caller
    "lib/wrapped/share/visit-counter.ts!",
    // colour maths for the token and contrast tests; its last app caller, the Chart.js theme, went in P10.9
    "lib/design/color.ts!",
    // the conversation review actions (MCP sees them only through a namespace import); the conversation page's review section is their first caller, drop this then
    "actions/admin/conversation-review.ts!",
    // the conversation review settings save (MCP sees it only through a namespace import); the settings page's Conversation review section is its first caller, drop this then
    "actions/admin/judge-settings.ts!",
    // the judge's backlog loaders (MCP's list_conversation_findings uses listFindings); the Findings tab is the others' first caller, drop this then
    "lib/data/conversation-findings.ts!",
    // the judge's per-conversation loaders; the conversation page (getConversationReview) and the Calls badges (reviewBadgesFor) are their first callers, drop this then
    "lib/data/conversation-review.ts!"
  ],
  "project": [
    "**/*.{js,mjs,cjs,ts,tsx}!",
    "app/globals.css!",
    "!**/__tests__/**!",
    "!**/*.test.{ts,tsx}!",
    "!e2e/**!",
    "!jest.setup.js!",
    "!prisma/seed.ts!"
  ],
  "ignore": [
    "lib/generated/**",
    ".agents/**",
    "eslint/restricted-syntax.mjs",
    ".claude/worktrees/**"
  ],
  "ignoreDependencies": [
    "zlib-sync",
    "@prisma/client"
  ],
  "ignoreBinaries": [
    "tsx"
  ]
}
