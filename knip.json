{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "instrumentation.ts!",
    "proxy.ts!",
    "scripts/*.ts!",
    "scripts/*.mjs!",
    "lib/queue/redis-lock.ts!",
    "lib/queue/redis-semaphore.ts!",
    "lib/queue/rewind-infra.ts!",
    "lib/rewind/infra-copy.ts!"
  ],
  "project": [
    "**/*.{js,mjs,cjs,ts,tsx}!",
    "!**/__tests__/**!",
    "!**/*.test.{ts,tsx}!",
    "!e2e/**!",
    "!test/**!",
    "!jest.setup.js!",
    "!prisma/seed.ts!"
  ],
  "ignore": [
    "lib/generated/**",
    ".agents/**",
    ".claude/worktrees/**"
  ],
  "ignoreDependencies": [
    "zlib-sync",
    "@prisma/client"
  ],
  "ignoreBinaries": [
    "tsx"
  ]
}
