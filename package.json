{
  "name": "plex-wrapped",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:e2e": "npm run build",
    "start": "next start",
    "start:prod": "NEXT_MANUAL_SIG_HANDLE=true node server.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "knip": "knip --production",
    "design:report": "node scripts/check-design-system.mjs --report",
    "design:check": "node scripts/check-design-system.mjs --check",
    "design:update": "node scripts/check-design-system.mjs --update",
    "design:baseline": "node scripts/check-design-system.mjs --baseline",
    "design:rewind-motion": "node scripts/design-system/rewind-motion.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:tz": "TZ=Pacific/Kiritimati jest lib/utils/__tests__/format.test.ts",
    "test:integration": "JEST_INTEGRATION=1 jest --runInBand --testPathPatterns '\\.(pg|redis)\\.test\\.ts$'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "rewind:fixtures": "tsx evals/rewind/generate-fixtures.ts",
    "rewind:e2e-fixtures": "tsx --conditions=react-server scripts/rewind-build-e2e-fixtures.ts",
    "eval:rewind": "tsx --conditions=react-server evals/rewind/run.ts",
    "eval:rewind:select": "tsx evals/rewind/bake-off.ts",
    "rewind:strip-leaderboards": "tsx --tsconfig tsconfig.scripts.json scripts/rewind-strip-leaderboards.ts",
    "rewind:measure-cards": "NODE_ENV=production tsx --conditions=react-server scripts/rewind-measure-cards.tsx",
    "rewind:card-version": "node scripts/write-card-version.mjs",
    "rewind:probe-sources": "tsx --conditions=react-server --tsconfig tsconfig.scripts.json scripts/rewind-probe-sources.ts",
    "rewind:gallery": "tsx --tsconfig tsconfig.scripts.json scripts/rewind-gallery.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "register-discord-metadata": "tsx --tsconfig tsconfig.scripts.json scripts/register-discord-metadata.ts",
    "register-discord-commands": "tsx --conditions=react-server --tsconfig tsconfig.scripts.json scripts/register-discord-commands.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.83",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai": "4.0.98",
    "@ai-sdk/openai-compatible": "3.0.73",
    "@base-ui/react": "1.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "8.21.3",
    "ai": "7.0.147",
    "bullmq": "^6.3.16",
    "chart.js": "^4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "fast-xml-parser": "^5.10.1",
    "fflate": "0.8.2",
    "ioredis": "5.11.1",
    "lucide-react": "^1.58.0",
    "motion": "14.3.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "rate-limiter-flexible": "11.2.3",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "^23.0.0",
    "subset-font": "2.9.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.4.0",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "^25.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.11.0",
    "chalk": "6.0.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jest": "^30.2.0",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-mock-extended": "4.0.2",
    "knip": "6.42.1",
    "postcss": "^8.4.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.2",
    "tsx": "4.23.15",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.52.0",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "zlib-sync": "^0.1.10"
  }
}
