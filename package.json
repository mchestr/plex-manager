{
  "name": "plex-wrapped",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:e2e": "npm run build",
    "start": "next start",
    "start:prod": "node server.js",
    "lint": "eslint .",
    "knip": "knip --production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:pg": "JEST_PG=1 jest --runInBand --testPathPatterns '\\.pg\\.test\\.ts$'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "rewind:strip-leaderboards": "tsx --tsconfig tsconfig.scripts.json scripts/rewind-strip-leaderboards.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "register-discord-metadata": "tsx --tsconfig tsconfig.scripts.json scripts/register-discord-metadata.ts",
    "register-discord-commands": "tsx --tsconfig tsconfig.scripts.json scripts/register-discord-commands.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.101.2",
    "bullmq": "^5.81.5",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "^12.42.2",
    "ioredis": "^5.8.2",
    "lucide-react": "^1.23.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "server-only": "0.0.1",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "winston": "^3.19.0",
    "zlib-sync": "^0.1.10",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "knip": "6.39.0",
    "postcss": "^8.4.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.2",
    "tsx": "4.23.15",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.52.0"
  }
}
