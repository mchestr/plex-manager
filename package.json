{
  "name": "plex-manager",
  "version": "0.8.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "build:e2e": "npm run build",
    "start": "next start",
    "start:prod": "NEXT_MANUAL_SIG_HANDLE=true node --env-file-if-exists=.env .next/standalone/server.js",
    "env:docs": "tsx --conditions=react-server --tsconfig tsconfig.scripts.json scripts/gen-env-reference.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "knip": "knip --production",
    "design:report": "node scripts/check-design-system.mjs --report",
    "design:check": "node scripts/check-design-system.mjs --strict",
    "design:rewind-motion": "node scripts/design-system/rewind-motion.mjs",
    "codemod:tokens": "tsx --tsconfig tsconfig.scripts.json scripts/codemods/tokens.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:tz": "TZ=Pacific/Kiritimati jest lib/utils/__tests__/format.test.ts",
    "test:integration": "JEST_INTEGRATION=1 jest --runInBand --testPathPatterns '\\.(pg|redis)\\.test\\.ts$'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "rewind:fixtures": "tsx evals/rewind/generate-fixtures.ts",
    "rewind:e2e-fixtures": "tsx --conditions=react-server scripts/rewind-build-e2e-fixtures.ts",
    "eval:rewind": "tsx --conditions=react-server evals/rewind/run.ts",
    "eval:rewind:select": "tsx evals/rewind/bake-off.ts",
    "rewind:strip-leaderboards": "tsx --tsconfig tsconfig.scripts.json scripts/rewind-strip-leaderboards.ts",
    "rewind:measure-cards": "NODE_ENV=production tsx --conditions=react-server scripts/rewind-measure-cards.tsx",
    "rewind:card-version": "node scripts/write-card-version.mjs",
    "rewind:freeze": "tsx --tsconfig tsconfig.scripts.json scripts/rewind-freeze.ts",
    "rewind:season-open": "tsx --conditions=react-server --tsconfig tsconfig.scripts.json scripts/rewind-season-open.ts",
    "rewind:validate": "tsx --conditions=react-server --tsconfig tsconfig.scripts.json scripts/rewind-validate.ts",
    "rewind:probe-sources": "tsx --conditions=react-server --tsconfig tsconfig.scripts.json scripts/rewind-probe-sources.ts",
    "services:rows-audit": "tsx --conditions=react-server --tsconfig tsconfig.scripts.json scripts/service-rows-audit.ts",
    "services:rows-apply": "tsx --conditions=react-server --tsconfig tsconfig.scripts.json scripts/service-rows-apply.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "register-discord-metadata": "tsx --tsconfig tsconfig.scripts.json scripts/register-discord-metadata.ts",
    "register-discord-commands": "tsx --conditions=react-server --tsconfig tsconfig.scripts.json scripts/register-discord-commands.ts",
    "build:discord-scripts": "esbuild scripts/register-discord-commands.ts scripts/register-discord-metadata.ts --bundle --platform=node --target=node24 --format=cjs --outdir=scripts/dist --out-extension:.js=.cjs --tsconfig=tsconfig.scripts.json --conditions=react-server --external:discord.js --log-level=warning"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.90",
    "@ai-sdk/google": "4.0.107",
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@base-ui/react": "1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "8.21.3",
    "ai": "7.0.155",
    "bullmq": "^6.3.16",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "fast-xml-parser": "^5.10.1",
    "fflate": "0.8.3",
    "ioredis": "5.11.1",
    "lucide-react": "^1.58.0",
    "motion": "14.7.1",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "rate-limiter-flexible": "11.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "^23.0.0",
    "subset-font": "2.9.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.4.0",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "^25.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "4.14.0",
    "chalk": "6.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jest": "^30.2.0",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-mock-extended": "4.0.2",
    "knip": "6.43.0",
    "postcss": "^8.4.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "zlib-sync": "^0.1.10"
  },
  "overrides": {
    "immer": "11.2.9",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
